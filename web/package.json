{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings 27",
    "preview": "vite preview",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc -b",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@nats-io/nats-core": "^3.4.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "nats.ws": "^1.30.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
